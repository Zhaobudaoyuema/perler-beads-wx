.page {
  min-height: 100vh;
  padding: 24rpx 24rpx 64rpx;
}

.hero {
  padding: 24rpx 8rpx 32rpx;
}
.hero-title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1f1f23;
  letter-spacing: 1rpx;
}
.hero-sub {
  margin-top: 8rpx;
  color: #8a8a99;
  font-size: 26rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 24rpx rgba(20, 20, 40, 0.04);
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1f1f23;
  margin-bottom: 24rpx;
}

/* 上传区 */
.upload-zone {
  border: 2rpx dashed #d6d6e0;
  border-radius: 20rpx;
  padding: 56rpx 24rpx;
  text-align: center;
  background: #fafaff;
  transition: all 0.2s;
}
.upload-icon {
  font-size: 80rpx;
  color: #c2c2cf;
  font-weight: 200;
  line-height: 1;
}
.upload-text {
  margin-top: 16rpx;
  color: #5a5a6e;
  font-size: 28rpx;
}
.upload-sub {
  margin-top: 8rpx;
  color: #a0a0b0;
  font-size: 24rpx;
}
.thumb {
  width: 100%;
  height: 360rpx;
  border-radius: 16rpx;
}
.thumb-hint {
  margin-top: 16rpx;
  color: #8a8a99;
  font-size: 24rpx;
}
.meta {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8a8a99;
}

/* 配置项 */
.form-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 0;
  border-top: 1rpx solid #f0f0f5;
}
.form-row:first-of-type {
  border-top: none;
}
.form-row-block {
  display: block;
}
.form-row-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.form-label {
  color: #5a5a6e;
  font-size: 28rpx;
}
.form-value {
  color: #1f1f23;
  font-size: 30rpx;
  font-weight: 600;
}
.picker {
  flex: 1;
  text-align: right;
}
.picker-value {
  color: #1f1f23;
  font-size: 28rpx;
  padding: 8rpx 16rpx;
  background: #f4f4f8;
  border-radius: 12rpx;
  display: inline-block;
}
.slider {
  margin: 16rpx 0 0;
}
.form-hint {
  color: #a0a0b0;
  font-size: 22rpx;
  margin-top: 8rpx;
}

/* 主按钮 */
.btn-primary {
  background: linear-gradient(135deg, #7c5cff, #5b8cff);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 16rpx;
  border: none;
}
.btn-primary.btn-disabled {
  background: #c8c8d4;
  color: #ffffff;
}

.btn-secondary {
  flex: 1;
  background: #f0eeff;
  color: #5b3cd6;
  font-size: 28rpx;
  font-weight: 500;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 14rpx;
  border: none;
}
.btn-secondary + .btn-secondary {
  margin-left: 20rpx;
}

.result-meta {
  margin-top: 20rpx;
  color: #8a8a99;
  font-size: 24rpx;
  text-align: center;
}

/* 预览 */
.preview-card {
  padding: 24rpx 16rpx;
}
.preview-empty {
  text-align: center;
  color: #b0b0c0;
  font-size: 26rpx;
  padding: 60rpx 0;
}
.preview-scroll {
  max-height: 900rpx;
  white-space: nowrap;
  background: #fafafd;
  border-radius: 12rpx;
  padding: 16rpx;
}
.preview-scroll-hidden {
  height: 0;
  max-height: 0;
  padding: 0;
  overflow: hidden;
}
.preview-canvas {
  display: block;
}

.export-row {
  display: flex;
  margin-top: 24rpx;
  padding: 0 8rpx;
}

/* 离屏 canvas 容器：移出可视区，避免影响布局 */
.offscreen {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
  overflow: hidden;
}

.footer {
  text-align: center;
  color: #b0b0c0;
  font-size: 22rpx;
  padding: 32rpx 0 16rpx;
}
